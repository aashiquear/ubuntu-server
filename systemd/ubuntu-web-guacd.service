[Unit]
Description=guacd (Guacamole RDP proxy) for Ubuntu Web Dashboard
Documentation=https://github.com/aashiquear/ubuntu-server
# `docker.service` may not exist (e.g. Docker installed via snap), so it is
# only referenced for ordering, never required — Restart handles a late daemon.
After=network-online.target docker.service snap.docker.dockerd.service
Wants=network-online.target
# Never give up retrying if the Docker daemon is slow to come up.
StartLimitIntervalSec=0

[Service]
# __DOCKER__ is replaced with the detected docker binary path by
# scripts/install-host.sh (handles /usr/bin/docker and snap's /snap/bin/docker).
#
# The image runs guacd via its default CMD (do NOT append args — guacd is not
# an ENTRYPOINT, so extra args would replace the whole command).
#
# Networking: guacd's own port is published to the host's loopback ONLY
# (127.0.0.1:4822), so it is never exposed to the LAN. To reach the host's
# XRDP, the container resolves `host.docker.internal` to the host via Docker's
# host-gateway; RDP_HOST is set to that name in /etc/ubuntu-web-dashboard.env.
ExecStartPre=-__DOCKER__ rm -f ubws-guacd
ExecStart=__DOCKER__ run --rm --name ubws-guacd \
  --add-host=host.docker.internal:host-gateway \
  -p 127.0.0.1:4822:4822 \
  guacamole/guacd:1.5.5
ExecStop=-__DOCKER__ stop ubws-guacd
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
