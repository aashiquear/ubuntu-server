[Unit]
Description=guacd (Guacamole RDP proxy) for Ubuntu Web Dashboard
Documentation=https://github.com/aashiquear/ubuntu-server
# `docker.service` may not exist (e.g. Docker installed via snap), so it is
# only referenced for ordering, never required — Restart handles a late daemon.
After=network-online.target docker.service snap.docker.dockerd.service
Wants=network-online.target
# Never give up retrying if the Docker daemon is slow to come up.
StartLimitIntervalSec=0

[Service]
# __DOCKER__ is replaced with the detected docker binary path by
# scripts/install-host.sh (handles /usr/bin/docker and snap's /snap/bin/docker).
#
# --network host is required: guacd must reach the HOST's XRDP at
# 127.0.0.1:3389. On the default bridge network, 127.0.0.1 would be the
# container's own loopback (no XRDP there) and the desktop session ends
# immediately. `-b 127.0.0.1` keeps guacd's own 4822 listener localhost-only.
ExecStartPre=-__DOCKER__ rm -f ubws-guacd
ExecStart=__DOCKER__ run --rm --name ubws-guacd --network host \
  guacamole/guacd:1.5.5 -b 127.0.0.1 -L info -f
ExecStop=-__DOCKER__ stop ubws-guacd
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
